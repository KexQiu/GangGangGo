{
  "name": "@xiaotidu/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @xiaotidu/contracts build && tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docs:generate": "pnpm --filter @xiaotidu/contracts build && node --import tsx scripts/generate-openapi.ts",
    "docs:check": "pnpm --filter @xiaotidu/contracts build && node --import tsx scripts/generate-openapi.ts --check",
    "data:purge-expired": "tsx scripts/purge-expired-data.ts",
    "data:purge-expired:prod": "node dist/cli/purgeExpiredData.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pretest": "pnpm --filter @xiaotidu/contracts build",
    "test": "vitest run",
    "test:ui:prepare": "tsx scripts/prepare-mobile-ui-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@hono/zod-openapi": "^1.4.0",
    "@xiaotidu/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "jose": "^6.2.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.7"
  }
}
