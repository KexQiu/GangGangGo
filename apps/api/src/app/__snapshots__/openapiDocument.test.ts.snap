                  "minimum": 0,
                  "type": "integer",
                },
                "member": {
                  "properties": {
                    "displayName": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "id": {
                      "format": "uuid",
                      "type": "string",
                    },
                    "user": {
                      "$ref": "#/components/schemas/UserSummary",
                    },
                  },
                  "required": [
                    "displayName",
                    "id",
                    "user",
                  ],
                  "type": "object",
                },
                "toiletRecordedDays": {
                  "minimum": 0,
                  "type": "integer",
                },
                "trainingDays": {
                  "minimum": 0,
                  "type": "integer",
                },
              },
              "required": [
                "habitFullDays",
                "member",
                "toiletRecordedDays",
                "trainingDays",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "endedAt",
          "memberCount",
          "startedAt",
          "summaries",
        ],
        "type": "object",
      },
      "UpdateBuddyNudgeSettingsRequest": {
        "additionalProperties": false,
        "properties": {
          "dailyLimit": {
            "anyOf": [
              {
                "enum": [
                  0,
                ],
                "type": "number",
              },
              {
                "enum": [
                  3,
                ],
                "type": "number",
              },
              {
                "enum": [
                  5,
                ],
                "type": "number",
              },
              {
                "enum": [
                  8,
                ],
                "type": "number",
              },
            ],
          },
          "enabled": {
            "type": "boolean",
          },
          "quietRanges": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "end": {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string",
                },
                "start": {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string",
                },
              },
              "required": [
                "end",
                "start",
              ],
              "type": "object",
            },
            "maxItems": 4,
            "type": "array",
          },
        },
        "required": [
          "dailyLimit",
          "enabled",
          "quietRanges",
        ],
        "type": "object",
      },
      "UpdateTeamMemberStatusRequest": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "active",
              "paused",
            ],
            "type": "string",
          },
        },
        "required": [
          "status",
        ],
        "type": "object",
      },
      "UpdateTeamRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "name",
        ],
        "type": "object",
      },
      "UpdateUserProfileRequest": {
        "additionalProperties": false,
        "properties": {
          "avatarUrl": {
            "$ref": "#/components/schemas/AvatarConfig",
          },
          "nickname": {
            "maxLength": 20,
            "minLength": 1,
            "type": [
              "string",
              "null",
            ],
          },
          "timezone": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpsertDailyReportSnapshotRequest": {
        "additionalProperties": false,
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/DailyReportSnapshot",
          },
        },
        "required": [
          "snapshot",
        ],
        "type": "object",
      },
      "UpsertDailyReportSnapshotsBulkRequest": {
        "additionalProperties": false,
        "properties": {
          "snapshots": {
            "items": {
              "$ref": "#/components/schemas/DailyReportSnapshot",
            },
            "maxItems": 90,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "snapshots",
        ],
        "type": "object",
      },
      "UpsertDailyShareSnapshotRequest": {
        "additionalProperties": false,
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/DailyShareSnapshot",
          },
        },
        "required": [
          "snapshot",
        ],
        "type": "object",
      },
      "UserProfile": {
        "properties": {
          "avatarUrl": {
            "$ref": "#/components/schemas/AvatarConfig",
          },
          "id": {
            "format": "uuid",
            "type": "string",
          },
          "nickname": {
            "type": [
              "string",
              "null",
            ],
          },
          "timezone": {
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "avatarUrl",
          "id",
          "nickname",
          "timezone",
        ],
        "type": "object",
      },
      "UserSummary": {
        "properties": {
          "avatarUrl": {
            "$ref": "#/components/schemas/AvatarConfig",
          },
          "id": {
            "format": "uuid",
            "type": "string",
          },
          "nickname": {
            "type": [
              "string",
              "null",
            ],
          },
        },
        "required": [
          "avatarUrl",
          "id",
          "nickname",
        ],
        "type": "object",
      },
      "VerifySubscriptionRequest": {
        "additionalProperties": false,
        "properties": {
          "productId": {
            "enum": [
              "xiaotidu.pro.monthly",
              "xiaotidu.pro.yearly",
            ],
            "type": "string",
          },
          "transactionId": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "productId",
          "transactionId",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
