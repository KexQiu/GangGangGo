          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "资源状态冲突",
          },
          "429": {
            "content": {
              "application/json": {
