                },
              },
            },
            "description": "未登录或会话失效",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "没有操作权限",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "资源不存在",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "资源状态冲突",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "请求超过限制",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
