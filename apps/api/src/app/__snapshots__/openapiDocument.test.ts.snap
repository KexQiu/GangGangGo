            "type": "array",
          },
        },
        "required": [
          "friends",
        ],
        "type": "object",
      },
      "GrowthEventsRequest": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "appVersion": {
                  "maxLength": 32,
                  "minLength": 1,
                  "type": "string",
                },
                "eventId": {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string",
                },
                "installationId": {
                  "pattern": "^[a-zA-Z0-9_-]{16,80}$",
                  "type": "string",
                },
                "name": {
                  "enum": [
                    "app_opened",
                    "activation_completed",
                    "login_completed",
                    "friend_invite_sent",
                    "friend_invite_accepted",
                    "advanced_report_viewed",
                    "watch_opened",
                    "watch_action_completed",
                    "sync_failed",
                    "feature_interest_submitted",
                  ],
                  "type": "string",
                },
                "occurredAt": {
                  "$ref": "#/components/schemas/IsoDateTime",
                },
                "platform": {
                  "enum": [
                    "ios",
                    "android",
                  ],
                  "type": "string",
                },
                "properties": {
                  "additionalProperties": false,
                  "default": {},
                  "properties": {
                    "action": {
                      "enum": [
                        "training",
                        "habit",
                        "toilet",
                      ],
                      "type": "string",
                    },
                    "domain": {
                      "enum": [
                        "full_data",
                        "report",
                        "watch",
                      ],
                      "type": "string",
                    },
                    "feature": {
                      "enum": [
                        "advanced_report",
                        "watch",
                        "long_history",
                        "insights",
                      ],
                      "type": "string",
                    },
                    "source": {
                      "enum": [
                        "app_open",
                        "trends",
                        "watch",
                        "friend",
                        "settings",
                      ],
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
              "required": [
                "appVersion",
                "eventId",
                "installationId",
                "name",
                "occurredAt",
                "platform",
              ],
              "type": "object",
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "events",
        ],
        "type": "object",
      },
      "GrowthEventsResponse": {
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "minimum": 0,
            "type": "integer",
          },
        },
        "required": [
          "accepted",
        ],
        "type": "object",
      },
      "IsoDate": {
        "format": "date",
        "type": "string",
      },
      "IsoDateTime": {
        "format": "date-time",
        "type": "string",
      },
      "ManualFriendNudgeEvent": {
        "additionalProperties": false,
        "properties": {
          "ack": {
            "$ref": "#/components/schemas/FriendNudgeAck",
          },
          "createdAt": {
            "$ref": "#/components/schemas/IsoDateTime",
          },
          "expiresAt": {
            "$ref": "#/components/schemas/IsoDateTime",
          },
          "friendshipId": {
            "format": "uuid",
            "type": "string",
          },
          "fromUser": {
            "$ref": "#/components/schemas/UserSummary",
          },
          "id": {
            "format": "uuid",
            "type": "string",
          },
          "kind": {
            "enum": [
              "manual_nudge",
            ],
            "type": "string",
          },
          "message": {
            "type": "string",
          },
          "nudgeType": {
            "enum": [
              "gentle",
              "move",
              "not_blank",
              "habit_left",
              "posture",
            ],
            "type": "string",
          },
          "occurredAt": {
            "$ref": "#/components/schemas/IsoDateTime",
          },
          "toUser": {
            "$ref": "#/components/schemas/UserSummary",
          },
        },
        "required": [
          "createdAt",
          "friendshipId",
          "fromUser",
          "id",
          "occurredAt",
          "toUser",
          "ack",
          "expiresAt",
          "kind",
          "message",
          "nudgeType",
        ],
        "type": "object",
      },
      "RefreshSessionRequest": {
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "refreshToken",
        ],
        "type": "object",
      },
      "RegisterPushTokenRequest": {
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string",
          },
          "platform": {
            "enum": [
              "android",
              "ios",
            ],
            "type": "string",
          },
          "provider": {
            "enum": [
              "apns",
              "expo",
            ],
            "type": "string",
          },
          "token": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "platform",
          "provider",
          "token",
        ],
        "type": "object",
      },
      "RegisterPushTokenResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "RestoreSubscriptionRequest": {
        "additionalProperties": false,
        "properties": {
          "transactionIds": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "transactionIds",
        ],
        "type": "object",
      },
      "SubscriptionActionResponse": {
        "properties": {
          "entitlements": {
            "$ref": "#/components/schemas/EntitlementsResponse",
          },
          "status": {
            "enum": [
              "pending_verification",
            ],
            "type": "string",
          },
        },
        "required": [
          "entitlements",
          "status",
        ],
        "type": "object",
      },
      "ToiletFinishedFriendEvent": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "$ref": "#/components/schemas/IsoDateTime",
          },
          "durationSeconds": {
            "minimum": 0,
            "type": [
              "integer",
              "null",
            ],
          },
          "friendshipId": {
            "format": "uuid",
            "type": "string",
          },
          "fromUser": {
            "$ref": "#/components/schemas/UserSummary",
          },
          "id": {
            "format": "uuid",
            "type": "string",
          },
          "kind": {
            "enum": [
              "toilet_finished",
            ],
            "type": "string",
          },
          "occurredAt": {
            "$ref": "#/components/schemas/IsoDateTime",
          },
          "toUser": {
            "$ref": "#/components/schemas/UserSummary",
          },
        },
        "required": [
          "createdAt",
          "friendshipId",
          "fromUser",
          "id",
          "occurredAt",
          "toUser",
          "durationSeconds",
          "kind",
        ],
        "type": "object",
      },
      "UpdateFriendSettingsRequest": {
        "additionalProperties": false,
        "properties": {
          "allowToiletEndNotificationsFromFriend": {
            "type": "boolean",
          },
          "habitLevel": {
            "enum": [
              "none",
              "summary",
              "detailed",
            ],
            "type": "string",
          },
          "historyDays": {
            "anyOf": [
              {
                "enum": [
                  1,
                ],
                "type": "number",
              },
              {
                "enum": [
                  7,
                ],
                "type": "number",
              },
              {
                "enum": [
                  30,
                ],
                "type": "number",
              },
            ],
          },
          "notifyFriendOnToiletEnd": {
            "type": "boolean",
          },
          "nudgeDailyLimit": {
            "anyOf": [
              {
                "enum": [
                  0,
                ],
                "type": "number",
              },
              {
                "enum": [
                  3,
                ],
                "type": "number",
              },
              {
                "enum": [
                  5,
                ],
                "type": "number",
              },
              {
                "enum": [
                  8,
                ],
                "type": "number",
              },
            ],
          },
          "nudgesEnabled": {
            "type": "boolean",
          },
          "quietRanges": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "end": {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string",
                },
                "start": {
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                  "type": "string",
                },
              },
              "required": [
                "end",
                "start",
              ],
              "type": "object",
            },
            "maxItems": 4,
            "type": "array",
          },
          "toiletLevel": {
            "enum": [
              "none",
              "summary",
              "detailed",
            ],
            "type": "string",
          },
          "trainingLevel": {
            "enum": [
              "none",
              "summary",
              "detailed",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateUserProfileRequest": {
        "additionalProperties": false,
        "properties": {
          "avatarUrl": {
            "$ref": "#/components/schemas/AvatarConfig",
          },
          "nickname": {
            "maxLength": 20,
            "minLength": 1,
            "type": [
              "string",
              "null",
            ],
          },
          "timezone": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpsertDailyReportSnapshotRequest": {
        "additionalProperties": false,
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/DailyReportSnapshot",
          },
        },
        "required": [
          "snapshot",
        ],
        "type": "object",
      },
      "UpsertDailyReportSnapshotsBulkRequest": {
        "additionalProperties": false,
        "properties": {
          "snapshots": {
            "items": {
              "$ref": "#/components/schemas/DailyReportSnapshot",
            },
            "maxItems": 90,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "snapshots",
        ],
        "type": "object",
      },
      "UserProfile": {
        "properties": {
          "avatarUrl": {
            "$ref": "#/components/schemas/AvatarConfig",
          },
          "id": {
            "format": "uuid",
            "type": "string",
          },
          "nickname": {
            "type": [
              "string",
              "null",
            ],
          },
          "timezone": {
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "avatarUrl",
          "id",
          "nickname",
          "timezone",
        ],
        "type": "object",
      },
      "UserSummary": {
        "properties": {
          "avatarUrl": {
            "$ref": "#/components/schemas/AvatarConfig",
          },
          "id": {
            "format": "uuid",
            "type": "string",
          },
          "nickname": {
            "type": [
              "string",
              "null",
            ],
          },
        },
        "required": [
          "avatarUrl",
          "id",
          "nickname",
        ],
        "type": "object",
      },
      "VerifySubscriptionRequest": {
        "additionalProperties": false,
        "properties": {
          "productId": {
            "enum": [
              "xiaotidu.pro.monthly",
              "xiaotidu.pro.yearly",
            ],
            "type": "string",
          },
          "transactionId": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "productId",
          "transactionId",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "title": "小提督 API",
    "version": "0.2.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/apple": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppleLoginRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuthResponse",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "成功",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "请求不合法",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "未登录或会话失效",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "没有操作权限",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "资源不存在",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "资源状态冲突",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "请求超过限制",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "服务内部错误",
          },
        },
        "summary": "Apple 或开发 Mock 登录",
      },
    },
    "/auth/logout": {
      "post": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "ok": {
                          "enum": [
                            true,
                          ],
                          "type": "boolean",
                        },
                      },
                      "required": [
                        "ok",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "成功",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "请求不合法",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "未登录或会话失效",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "没有操作权限",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "资源不存在",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "资源状态冲突",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "请求超过限制",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse",
                },
              },
            },
            "description": "服务内部错误",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "撤销当前会话",
      },
    },
    "/auth/refresh": {
      "post": {
        "requestBody": {
          "content": {
