{
  "name": "xiaotidu-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api:dev": "pnpm --filter @xiaotidu/api dev",
    "api:start": "pnpm --filter @xiaotidu/api start",
    "mobile:start": "pnpm --filter @xiaotidu/mobile start",
    "mobile:ios": "pnpm --filter @xiaotidu/mobile ios",
    "mobile:android": "pnpm --filter @xiaotidu/mobile android",
    "mobile:dev-client": "pnpm --filter @xiaotidu/mobile start:dev-client",
    "api:typecheck": "pnpm --filter @xiaotidu/api typecheck",
    "contracts:typecheck": "pnpm --filter @xiaotidu/contracts typecheck",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "~5.9.2"
  }
}
